# 1. Server Port Configuration
# Port numbers for server and proxy are strictly managed via this file.
PORT=5173
VITE_PORT=5173

# 2. Proxy Configuration (Optional: uncomment and configure if backend API is proxied)
# PROXY_PORT=5000
# PROXY_TARGET=http://localhost:5000

# 3. Allowed Hosts Configuration
# Prevents "Blocked request. This host ('domainname') is not allowed."
# Set to 'true' or '*' to allow all host domains (recommended for reverse proxies & cloud domains),
# or specify a comma-separated list of allowed domains (e.g. yourdomain.com,app.yourdomain.com).
ALLOWED_HOSTS=true

# 4. PostgreSQL Database Configuration
